---
// Sprach-Einstieg: leitet auf die Über-mich-Seite weiter.
// Bewusst als Meta-Refresh statt Astro.redirect(): das i18n-Routing entfernt
// dort das Locale-Praefix und landet auf der falschen Seite.
import { SITE_CONFIG } from '@/constants/site';

export const prerender = true;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/de/about`;
const canonical = `${SITE_CONFIG.url}/de/about/`;
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
  </head>
  <body></body>
</html>
