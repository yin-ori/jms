---
import { SITE_CONFIG } from '@/constants/site';

export const prerender = true;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/en/about`;
const canonical = `${SITE_CONFIG.url}/en/about/`;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
  </head>
  <body></body>
</html>